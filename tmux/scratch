#!/usr/bin/env bash
# scratch [dir]: attach to the persistent "scratch" session (prefix t), a
# single shell that survives closing the popup. If it is already running it is
# reused as is, wherever it is; otherwise it starts in [dir] (default: the
# current folder, which prefix t sets to the pane's folder, or the folder
# Claude is in for a Claude pane). `exit` ends it.
set -euo pipefail
dir=${1:-$PWD}

if ! tmux has-session -t '=scratch' 2>/dev/null; then
  tmux new-session -d -s scratch -c "$dir"
  tmux set-option -t '=scratch:' status off
  # Close the popup when the shell exits, rather than switching it to another
  # session (detach-on-destroy is off globally in tmux.conf). The trailing
  # colon matters: set-option rejects a bare '=scratch' target.
  tmux set-option -t '=scratch:' detach-on-destroy on
fi

# We run inside a popup of this same server, so clear TMUX to allow attaching.
TMUX= exec tmux attach-session -t '=scratch'
